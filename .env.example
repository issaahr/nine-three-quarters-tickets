PORT=3000
NODE_ENV=development
POSTGRES_DB=ntq-tickets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/ntq-tickets
DEMO_USERS_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=900
TICKET_HMAC_SECRET=replace-with-at-least-32-random-characters
RESERVATION_HOLD_DURATION_SECONDS=600
PAYMENT_CARD_PENDING_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:5173
PUBLIC_SIGNUP_ENABLED=true
TRUST_PROXY_HOPS=0
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_CATALOG_WINDOW_SECONDS=60
RATE_LIMIT_CATALOG_MAX_REQUESTS=30
RATE_LIMIT_CHECK_IN_WINDOW_SECONDS=60
RATE_LIMIT_CHECK_IN_MAX_REQUESTS=20
TMDB_API_READ_ACCESS_TOKEN=replace-with-your-tmdb-read-access-token
TMDB_LANGUAGE=pt-BR
TMDB_REQUEST_TIMEOUT_MS=5000
TMDB_POSTER_SIZE=w500
TICKETMASTER_API_KEY=replace-with-your-ticketmaster-api-key
TICKETMASTER_LOCALE=pt-BR
TICKETMASTER_REQUEST_TIMEOUT_MS=5000
VITE_API_URL=http://localhost:3000
VITE_DEMO_USERS_PASSWORD=change-me
